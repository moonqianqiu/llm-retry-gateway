{
  "listen": "127.0.0.1:18888",
  "allowHttp": false,
  "allowedUpstreamHosts": [],
  "maxBodyBytes": 262144,
  "logLevel": "info",
  "normalRamp": {
    "delaysMs": [2000, 2000, 3000, 3000, 3000, 4500, 4500, 6750, 10000],
    "jitterRatio": 0.25
  },
  "ambiguousRamp": {
    "delaysMs": [4000, 6000, 9000, 13500, 20250, 30000],
    "jitterRatio": 0.25
  },
  "retryAfterCapRatio": 4,
  "responseHeaderTimeoutSec": 120,
  "smallRetryAfterFixed": false,
  "quotaExhaustedPatterns": [
    "credit_balance_exhausted",
    "organization_usage_limit_exceeded",
    "organization_spend_limit_exceeded",
    "project_spend_limit_exceeded",
    "daily usage limit exceeded"
  ],
  "rateLimitPatterns": [
    "rate_limit_exceeded",
    "token_rate_limit_exceeded",
    "ip_rate_limit_exceeded",
    "concurrency_rate_limit_exceeded",
    "tpm exhausted",
    "rpm exhausted"
  ]
}
